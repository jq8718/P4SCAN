menuconfig CAMERA_OV01C1B
    bool "OV01C1B"
    default y
    depends on SOC_MIPI_CSI_SUPPORTED
    help
        Enable support for the OV01C1B CMOS image sensor.

if CAMERA_OV01C1B
    config CAMERA_OV01C1B_AUTO_DETECT_MIPI_INTERFACE_SENSOR
        bool "Detect OV01C1B on MIPI CSI interface"
        default y

    config CAMERA_OV01C1B_MIPI_RAW10_1024X1024_50FPS
        bool "MIPI 1-lane, 24M input, 1024x1024 50fps, RAW10"
        default y

    choice CAMERA_OV01C1B_MIPI_DEFAULT_FMT
        prompt "Select default output format for MIPI CSI interface"
        default CAMERA_OV01C1B_MIPI_DEFAULT_FMT_RAW10_1024X1024_50FPS

        config CAMERA_OV01C1B_MIPI_DEFAULT_FMT_RAW10_1024X1024_50FPS
            bool "MIPI 1-lane, 24M input, 1024x1024 50fps, RAW10"
            depends on CAMERA_OV01C1B_MIPI_RAW10_1024X1024_50FPS
    endchoice

    config CAMERA_OV01C1B_MIPI_IF_FORMAT_INDEX_DEFAULT
        int
        default 0 if CAMERA_OV01C1B_MIPI_DEFAULT_FMT_RAW10_1024X1024_50FPS

    config CAMERA_OV01C1B_MIPI_CLK_MHZ
        int "MIPI lane bit rate in MHz"
        range 100 1500
        default 1300
        help
            Bring-up default comes from the vendor register file comment
            "phy_clk=1434M". Adjust this after oscilloscope measurement.

    config CAMERA_OV01C1B_KEEP_STREAM_ON
        bool "Keep OV01C1B stream enabled when CSI stops"
        default n
        help
            Keep the sensor transmitting MIPI after the CSI video device is
            stopped. This is only for probing the MIPI clock during bring-up;
            it prevents a later CSI reopen from restarting the sensor cleanly.

    config CAMERA_OV01C1B_TEST_PATTERN
        bool "Enable OV01C1B internal test pattern"
        default n
        help
            Enable the sensor's internal test pattern registers for MIPI/CSI
            bring-up. The test pattern is monochrome and is not camera output.

    config CAMERA_OV01C1B_COLORBAR_FULL_1032X1032
        bool "Use 1032x1032 CSI dimensions for ColorBar"
        depends on CAMERA_OV01C1B_TEST_PATTERN
        default n
        help
            OV01C1B ColorBar output uses the sensor's full 1032x1032 pattern
            size. Enable this only when the internal ColorBar is enabled.

    choice CAMERA_OV01C1B_BAYER_PATTERN
        prompt "Bayer pattern"
        default CAMERA_OV01C1B_BAYER_BGGR
        help
            Temporary bring-up default. Confirm with raw frame analysis later.

        config CAMERA_OV01C1B_BAYER_RGGB
            bool "RGGB"
        config CAMERA_OV01C1B_BAYER_GRBG
            bool "GRBG"
        config CAMERA_OV01C1B_BAYER_GBRG
            bool "GBRG"
        config CAMERA_OV01C1B_BAYER_BGGR
            bool "BGGR"
    endchoice
endif
